# Sentido backend — example environment file.
# Copy to `.env` for local dev. The `.env` file is gitignored; this one is committed.
# Variable names mirror docs/instructions/backend-implementation-plan.md §8.

# --- Required ---
DATABASE_URL=postgresql+asyncpg://sentido:sentido@localhost:5433/sentido
OPENAI_API_KEY=sk-replace-me
ADMIN_TOKEN=replace-me-with-a-long-random-string
GOOGLE_BOOKS_API_KEY=replace-me
CORS_ORIGINS=http://localhost:3000

# --- Optional (defaults shown) ---
OPENAI_BASE_URL=https://api.openai.com/v1
OPEN_LIBRARY_USER_AGENT=Sentido/1.0 (https://sentido.app)
LOG_LEVEL=INFO
ENV=development
