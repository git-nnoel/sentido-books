# Sentido backend — example environment file.
#
# Copy to backend/.env for local dev. The .env file is gitignored;
# this one is committed.
#
# First-boot checklist:
#   1. Fill in OPENAI_API_KEY (required for any LLM generation).
#   2. Choose a strong ADMIN_TOKEN (required to use admin endpoints).
#   3. Everything else has a sensible default — leave as-is.

# ──────────────────────────────────────────────────────────────────────────
# Required — fill these in.
# ──────────────────────────────────────────────────────────────────────────

# Your OpenAI key. The api uses it for synopsis + emotional profile +
# embedding (book generation) and resonance-line generation (search).
OPENAI_API_KEY=sk-replace-me

# Bearer token the admin endpoints require. Choose a long random
# string — this is what you'll paste into the admin login page.
ADMIN_TOKEN=replace-me-with-a-long-random-string

# ──────────────────────────────────────────────────────────────────────────
# Required but Phase-0 doesn't call it.
# ──────────────────────────────────────────────────────────────────────────

# Google Books fallback is a Phase-1 feature (the ingestion module
# only calls Open Library in Phase 0). The Settings class still
# validates the field at startup, so any non-empty placeholder works
# until Phase 1 wires the fallback.
GOOGLE_BOOKS_API_KEY=phase-0-unused-placeholder

# ──────────────────────────────────────────────────────────────────────────
# Optional — defaults shown.
# ──────────────────────────────────────────────────────────────────────────

# Comma-separated CORS allowlist. Add your Vercel preview / prod
# domains when you deploy.
CORS_ORIGINS=http://localhost:3000

# OpenAI base URL — override if you use a proxy or a mock server.
OPENAI_BASE_URL=https://api.openai.com/v1

# User-Agent header sent to Open Library (mandatory by their policy).
OPEN_LIBRARY_USER_AGENT=Sentido/1.0 (https://sentido.app)

LOG_LEVEL=INFO
ENV=development

# ──────────────────────────────────────────────────────────────────────────
# DATABASE_URL.
#
# The value below targets `localhost:5433` — the host port Postgres is
# mapped to. This is what you want when you run alembic or pytest
# DIRECTLY from the host (no compose around them).
#
# When the api/migrate services run INSIDE compose, docker-compose.yml
# sets DATABASE_URL via its own `environment:` block, overriding this
# value with the in-network address (db:5432). So this entry works in
# both cases — no manual switching needed.
# ──────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://sentido:sentido@localhost:5433/sentido
